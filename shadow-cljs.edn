{:deps {:aliases [:cljs]}
 :dev-http {8081 {:root "public"
                  :push-state/index "index.html"}}
 :builds {:app {:target :browser
                :output-dir "public/js"
                :asset-path "/js"
                :modules {:main {:init-fn sdfs.core/init!}}
                :devtools {:after-load sdfs.core/reload!}}}}
